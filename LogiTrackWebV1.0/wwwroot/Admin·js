function renderListModal(list) {
    const tbody = document.getElementById('listModalBody');
    tbody.innerHTML = '';
    if (!list || list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:var(--text-muted);">No shipments.</td></tr>';
    } else {
        list.forEach(s => {
            tbody.innerHTML += `
                <tr>
                    <td><strong>${escapeHtml(s.trackingNumber)}</strong></td>
                    <td>${escapeHtml(s.destinationName || 'N/A')}</td>
                    <td>${s.weight} kg</td>
                    <td><span class="badge ${getStatusBadgeClass(s.status)}">${escapeHtml(s.status)}</span></td>
                </tr>
            `;
        });
    }
    document.getElementById('listModal').style.display = 'flex';
}

function closeModal(id) {
    document.getElementById(id).style.display = 'none';
}