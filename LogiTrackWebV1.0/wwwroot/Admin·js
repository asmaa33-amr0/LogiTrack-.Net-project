// ============================================================
// LogiTrack - Admin Portal (admin.html)
// يعتمد على auth.js (لازم يتحمل قبله في الصفحة)
// ============================================================

let adminShipmentsCache = [];
let adminWarehousesCache = [];
let adminDriversCache = [];
let adminStationsCache = [];

let lookupWarehouses = [];
let lookupDrivers = [];
let lookupStations = [];

document.addEventListener('DOMContentLoaded', () => {
    if (!requireRole('Admin', 'index.html')) return;

    document.getElementById('admin-user-name').textContent = getUsername() || 'Admin';
    document.getElementById('btn-admin-logout').addEventListener('click', () => logout('index.html'));
    document.getElementById('btn-refresh-admin').addEventListener('click', loadShipments);

    setupTabs();
    loadShipments();
});

function setupTabs() {
    const tabs = document.querySelectorAll('.tabs .tab');
    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('is-active'));
            tab.classList.add('is-active');

            const target = tab.getAttribute('data-tab');
            document.querySelectorAll('.app-container > .panel').forEach(p => p.hidden = true);
            document.getElementById(`panel-${target}`).hidden = false;

            if (target === 'shipments') loadShipments();
            if (target === 'warehouses') loadWarehouses();
            if (target === 'drivers') loadDrivers();
            if (target === 'stations') loadStations();
        });
    });
}

// ================================================================
// SHIPMENTS
// ================================================================

async function loadShipments() {
    try {
        adminShipmentsCache = await apiFetch('/Shipments');
        renderShipmentsTable(adminShipmentsCache);
    } catch (e) {
        console.error(e);
    }
}

function filterAdminTable() {
    const q = document.getElementById('admin-search-input').value.toLowerCase();
    const filtered = adminShipmentsCache.filter(item =>
        (item.trackingNumber || '').toLowerCase().includes(q) ||
        (item.warehouseName || '').toLowerCase().includes(q) ||
        (item.destinationName || '').toLowerCase().includes(q) ||
        (item.driverName || '').toLowerCase().includes(q)
    );
    renderShipmentsTable(filtered);
}

function renderShipmentsTable(shipments) {
    const tbody = document.getElementById('admin-shipments-body');
    tbody.innerHTML = '';

    let total = shipments.length, pending = 0, completed = 0;

    if (total === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color: var(--text-muted);">No shipments found.</td></tr>`;
    } else {
        shipments.forEach(item => {
            const status = item.status || 'Pending';
            if (status === 'Delivered') completed++; else pending++;

            const row = document.createElement('tr');
            row.innerHTML = `
                <td><strong>${escapeHtml(item.trackingNumber)}</strong></td>
                <td>${escapeHtml(item.warehouseName)}</td>
                <td>${escapeHtml(item.destinationName)}</td>
                <td>${escapeHtml(item.driverName)}</td>
                <td>${item.weight} kg</td>
                <td><span class="badge ${getStatusBadgeClass(status)}">${escapeHtml(status)}</span></td>
                <td>
                    <div class="row-actions">
                        <button class="btn-action btn-view" onclick="openTrackModal(${item.id})">Track</button>
                        <button class="btn-action btn-edit" onclick="openShipmentModal(${item.id})">Edit</button>
                        <button class="btn-action btn-delete" onclick="deleteShipment(${item.id})">Delete</button>
                    </div>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    document.getElementById('stat-total-shipments').textContent = total;
    document.getElementById('stat-pending-shipments').textContent = pending;
    document.getElementById('stat-completed-shipments').textContent = completed;
}

async function loadShipmentLookups() {
    const [warehouses, drivers, stations] = await Promise.all([
        apiFetch('/Shipments/warehouses-lookup'),
        apiFetch('/Shipments/drivers-lookup'),
        apiFetch('/Shipments/stations-lookup')
    ]);
    lookupWarehouses = warehouses;
    lookupDrivers = drivers;
    lookupStations = stations;

    fillSelect('shipment-warehouse', lookupWarehouses, 'Select warehouse');
    fillSelect('shipment-driver', lookupDrivers, 'Select driver');
    fillSelect('shipment-station', lookupStations, 'Select destination');
}

function fillSelect(id, items, placeholder) {
    const select = document.getElementById(id);
    select.innerHTML = `<option value="">${placeholder}</option>`;
    items.forEach(i => select.innerHTML += `<option value="${i.id}">${escapeHtml(i.name)}</option>`);
}

async function openShipmentModal(id) {
    await loadShipmentLookups();

    document.getElementById('shipment-id').value = id || '';
    document.getElementById('shipmentModalTitle').textContent = id ? 'Edit Shipment' : 'New Shipment';
    document.getElementById('shipment-tracking').value = '';
    document.getElementById('shipment-weight').value = '';
    document.getElementById('shipment-status').value = 'Pending';
    document.getElementById('shipment-date').value = '';
    document.getElementById('shipment-warehouse').value = '';
    document.getElementById('shipment-station').value = '';
    document.getElementById('shipment-driver').value = '';

    if (id) {
        try {
            const s = await apiFetch(`/Shipments/${id}`);
            document.getElementById('shipment-tracking').value = s.trackingNumber || '';
            document.getElementById('shipment-weight').value = s.weight || '';
            document.getElementById('shipment-status').value = s.status || 'Pending';
            document.getElementById('shipment-date').value = s.receiveDate ? s.receiveDate.split('T')[0] : '';
            document.getElementById('shipment-warehouse').value = s.warehouse ? s.warehouse.id : '';
            document.getElementById('shipment-station').value = s.endStation ? s.endStation.id : '';
            document.getElementById('shipment-driver').value = s.driver ? s.driver.id : '';
        } catch (e) {
            alert(e.message);
            return;
        }
    }

    document.getElementById('shipmentModal').style.display = 'flex';
}

async function saveShipment() {
    const id = document.getElementById('shipment-id').value;
    const weight = parseFloat(document.getElementById('shipment-weight').value);
    const warehouseId = parseInt(document.getElementById('shipment-warehouse').value);
    const driverId = parseInt(document.getElementById('shipment-driver').value);
    const endStationId = document.getElementById('shipment-station').value
        ? parseInt(document.getElementById('shipment-station').value) : null;
    const receiveDate = document.getElementById('shipment-date').value || null;

    if (!weight || weight <= 0) { alert('من فضلك أدخل وزن صحيح'); return; }
    if (!warehouseId) { alert('من فضلك اختار مستودع'); return; }
    if (!driverId) { alert('من فضلك اختار سواق'); return; }

    const payload = {
        trackingNumber: document.getElementById('shipment-tracking').value.trim(),
        weight,
        status: document.getElementById('shipment-status').value,
        warehouseId,
        driverId,
        endStationId,
        receiveDate
    };

    try {
        if (id) {
            await apiFetch(`/Shipments/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
        } else {
            await apiFetch('/Shipments', { method: 'POST', body: JSON.stringify(payload) });
        }
        closeModal('shipmentModal');
        loadShipments();
    } catch (e) {
        alert(e.message);
    }
}

async function deleteShipment(id) {
    if (!confirm('متأكد عايز تمسح الشحنة دي؟')) return;
    try {
        await apiFetch(`/Shipments/${id}`, { method: 'DELETE' });
        loadShipments();
    } catch (e) {
        alert(e.message);
    }
}

async function openTrackModal(id) {
    try {
        const [shipment, checkpoints] = await Promise.all([
            apiFetch(`/Shipments/${id}`),
            apiFetch(`/DriverUi/shipment/${id}/checkpoints`)
        ]);

        document.getElementById('trackModalTitle').textContent =
            `Track: ${shipment.trackingNumber} (${shipment.status})`;

        const body = document.getElementById('trackModalBody');
        if (!checkpoints || checkpoints.length === 0) {
            body.innerHTML = '<p class="muted-note">لسه مفيش نقاط تتبع مسجلة لهذه الشحنة.</p>';
        } else {
            body.innerHTML = checkpoints.map(cp => `
                <div class="timeline-item">
                    <div class="timeline-station">${escapeHtml(cp.stationName)}</div>
                    <div class="timeline-info">${escapeHtml(cp.info || '')}</div>
                    <div class="timeline-time">${formatDateTime(cp.timestamp)}</div>
                </div>
            `).join('');
        }

        document.getElementById('trackModal').style.display = 'flex';
    } catch (e) {
        alert(e.message);
    }
}

