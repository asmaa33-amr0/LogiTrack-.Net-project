// WAREHOUSES
// ================================================================

async function loadWarehouses() {
    try {
        adminWarehousesCache = await apiFetch('/Warehouses');
        renderWarehousesTable(adminWarehousesCache);
    } catch (e) {
        console.error(e);
    }
}

function renderWarehousesTable(list) {
    const tbody = document.getElementById('admin-warehouses-body');
    tbody.innerHTML = '';
    if (!list || list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:var(--text-muted);">No warehouses yet.</td></tr>';
        return;
    }
    list.forEach(w => {
        tbody.innerHTML += `
            <tr>
                <td><strong>${escapeHtml(w.name)}</strong></td>
                <td>${escapeHtml(w.city)}</td>
                <td>${w.latitude}, ${w.longitude}</td>
                <td>
                    <div class="row-actions">
                        <button class="btn-action btn-view" onclick="viewWarehouseShipments(${w.id}, '${escapeHtml(w.name).replace(/'/g, "\\'")}')">Shipments</button>
                        <button class="btn-action btn-edit" onclick="openWarehouseModal(${w.id})">Edit</button>
                        <button class="btn-action btn-delete" onclick="deleteWarehouse(${w.id})">Delete</button>
                    </div>
                </td>
            </tr>
        `;
    });
}

function openWarehouseModal(id) {
    document.getElementById('warehouse-id').value = id || '';
    document.getElementById('warehouseModalTitle').textContent = id ? 'Edit Warehouse' : 'New Warehouse';

    const existing = id ? adminWarehousesCache.find(w => w.id === id) : null;
    document.getElementById('warehouse-name').value = existing ? existing.name : '';
    document.getElementById('warehouse-city').value = existing ? existing.city : '';
    document.getElementById('warehouse-lat').value = existing ? existing.latitude : '';
    document.getElementById('warehouse-lng').value = existing ? existing.longitude : '';

    document.getElementById('warehouseModal').style.display = 'flex';
}

async function saveWarehouse() {
    const id = document.getElementById('warehouse-id').value;
    const payload = {
        name: document.getElementById('warehouse-name').value.trim(),
        city: document.getElementById('warehouse-city').value.trim(),
        latitude: parseFloat(document.getElementById('warehouse-lat').value) || 0,
        longitude: parseFloat(document.getElementById('warehouse-lng').value) || 0
    };
    if (!payload.name) { alert('من فضلك أدخل اسم المستودع'); return; }

    try {
        if (id) await apiFetch(`/Warehouses/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
        else await apiFetch('/Warehouses', { method: 'POST', body: JSON.stringify(payload) });
        closeModal('warehouseModal');
        loadWarehouses();
    } catch (e) {
        alert(e.message);
    }
}

async function deleteWarehouse(id) {
    if (!confirm('متأكد عايز تمسح المستودع ده؟')) return;
    try {
        await apiFetch(`/Warehouses/${id}`, { method: 'DELETE' });
        loadWarehouses();
    } catch (e) {
        alert(e.message);
    }
}

async function viewWarehouseShipments(id, name) {
    try {
        const list = await apiFetch(`/Warehouses/${id}/shipments`);
        document.getElementById('listModalTitle').textContent = `Shipments from: ${name}`;
        renderListModal(list);
    } catch (e) {
        alert(e.message);
    }
}

// ================================================================
// DRIVERS
// ================================================================

async function loadDrivers() {
    try {
        adminDriversCache = await apiFetch('/Drivers');
        renderDriversTable(adminDriversCache);
    } catch (e) {
        console.error(e);
    }
}

function renderDriversTable(list) {
    const tbody = document.getElementById('admin-drivers-body');
    tbody.innerHTML = '';
    if (!list || list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted);">No drivers yet.</td></tr>';
        return;
    }
    list.forEach(d => {
        tbody.innerHTML += `
            <tr>
                <td><strong>${escapeHtml(d.fullName)}</strong></td>
                <td>${escapeHtml(d.phone)}</td>
                <td>${escapeHtml(d.licenseNumber)}</td>
                <td>${d.expiryDate ? new Date(d.expiryDate).toLocaleDateString() : '-'}</td>
                <td>${d.linkedUserName ? escapeHtml(d.linkedUserName) : '<span class="muted-note">Not linked</span>'}</td>
                <td>
                    <div class="row-actions">
                        <button class="btn-action btn-view" onclick="viewDriverShipments(${d.id}, '${escapeHtml(d.fullName).replace(/'/g, "\\'")}')">Shipments</button>
                        <button class="btn-action btn-edit" onclick="openDriverModal(${d.id})">Edit</button>
                        <button class="btn-action btn-delete" onclick="deleteDriver(${d.id})">Delete</button>
                    </div>
                </td>
            </tr>
        `;
    });
}

async function openDriverModal(id) {
    document.getElementById('driver-id').value = id || '';
    document.getElementById('driverModalTitle').textContent = id ? 'Edit Driver' : 'New Driver';

    const existing = id ? adminDriversCache.find(d => d.id === id) : null;
    document.getElementById('driver-fullname').value = existing ? existing.fullName : '';
    document.getElementById('driver-phone').value = existing ? existing.phone : '';
    document.getElementById('driver-license').value = existing ? existing.licenseNumber : '';
    document.getElementById('driver-expiry').value = existing && existing.expiryDate ? existing.expiryDate.split('T')[0] : '';

    try {
        const accounts = await apiFetch('/Auth/driver-accounts');
        const select = document.getElementById('driver-user');
        select.innerHTML = '<option value="">No login account linked</option>';

        if (existing && existing.userId) {
            select.innerHTML += `<option value="${existing.userId}" selected>${escapeHtml(existing.linkedUserName || existing.userId)} (current)</option>`;
        }
        accounts.forEach(a => {
            select.innerHTML += `<option value="${a.id}">${escapeHtml(a.userName)} (${escapeHtml(a.email || '')})</option>`;
        });
    } catch (e) {
        console.error(e);
    }

    document.getElementById('driverModal').style.display = 'flex';
}

async function saveDriver() {
    const id = document.getElementById('driver-id').value;
    const payload = {
        fullName: document.getElementById('driver-fullname').value.trim(),
        phone: document.getElementById('driver-phone').value.trim(),
        licenseNumber: document.getElementById('driver-license').value.trim(),
        expiryDate: document.getElementById('driver-expiry').value || null,
        userId: document.getElementById('driver-user').value || null
    };
    if (!payload.fullName) { alert('من فضلك أدخل اسم السواق'); return; }

    try {
        if (id) await apiFetch(`/Drivers/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
        else await apiFetch('/Drivers', { method: 'POST', body: JSON.stringify(payload) });
        closeModal('driverModal');
        loadDrivers();
    } catch (e) {
        alert(e.message);
    }
}

async function deleteDriver(id) {
    if (!confirm('متأكد عايز تمسح السواق ده؟')) return;
    try {
        await apiFetch(`/Drivers/${id}`, { method: 'DELETE' });
        loadDrivers();
    } catch (e) {
        alert(e.message);
    }
}

async function viewDriverShipments(id, name) {
    try {
        const list = await apiFetch(`/Drivers/${id}/shipments`);
        document.getElementById('listModalTitle').textContent = `Shipments assigned to: ${name}`;
        renderListModal(list);
    } catch (e) {
        alert(e.message);
    }
}

